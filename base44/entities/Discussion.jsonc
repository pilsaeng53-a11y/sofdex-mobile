{
  "name": "Discussion",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "enum": [
        "market",
        "governance",
        "rwa",
        "strategies"
      ],
      "default": "market"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "reply_count": {
      "type": "number",
      "default": 0
    },
    "is_pinned": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "channel",
    "title",
    "body",
    "author_name"
  ]
}